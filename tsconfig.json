{
  // Editor, typecheck and lint config: covers app code, tests and tooling. The build uses tsconfig.build.json.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "rootDir": ".",
    "noEmit": true,
    // Tests import tools that run on Node's type stripping (tools/mock-meta). The build turns this off, so app
    // code still imports `.js` (R16).
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "eslint", "scripts", "tools", "vitest.config.ts"]
}
