# Copy to .env for local development. Real environment variables override this file.
# Every variable is validated at startup by the schemas in src/config; a test keeps this file in sync with them.

# --- app (src/config/app.config.ts) ---
# How Node and libraries behave: development | test | production
NODE_ENV=development
# Which deployment this is: local | staging | production
APP_ENV=local
# Port the API listens on.
PORT=3000
# Minimum log level: silent | fatal | error | warn | info | debug | trace (production: info or quieter, never silent)
LOG_LEVEL=info
# Service name shown in logs and metrics.
APP_NAME=helium-backend
# Browser origins allowed to call the API, comma-separated (https://admin.example.com). Empty: none.
CORS_ORIGINS=

# --- auth (src/config/auth.config.ts) ---
# Callers allowed to call the API, as JSON {"<iss>":"<secret of 32+ characters>"}. Local-only value below;
# `pnpm dev:token` signs a dev token with it.
AUTH_CALLER_SECRETS={"helium-admin":"local-dev-secret-not-for-any-deployment"}

# --- database (src/config/database.config.ts) ---
# Today's Helium database (read-only user when deployed). Local: the replica set from docker-compose.yml.
MONGO_MAIN_URI=mongodb://localhost:27017/helium?replicaSet=rs0&directConnection=true
# The messaging database.
MONGO_MESSAGING_URI=mongodb://localhost:27017/helium_messaging?replicaSet=rs0&directConnection=true
# Path to the DocumentDB CA bundle; when set, connections use TLS. Empty locally.
MONGO_TLS_CA_FILE=
# Most connections each named connection keeps open, per process.
MONGO_POOL_SIZE=20

# --- redis (src/config/redis.config.ts) ---
# redis:// locally (docker-compose Valkey); rediss:// (TLS) for ElastiCache.
REDIS_URL=redis://localhost:6379
# ElastiCache auth token. Empty locally.
REDIS_AUTH_TOKEN=

# --- queue (src/config/queue.config.ts) ---
# AWS region of the queues.
AWS_REGION=ap-south-1
# ElasticMQ (docker-compose) locally. Empty in AWS.
SQS_ENDPOINT=http://localhost:9324
# A queue's URL without its short name (prefix + "wa-send" = the queue URL).
SQS_QUEUE_URL_PREFIX=http://localhost:9324/000000000000/helium-local-
# Send MessageGroupId to standard (fair) queues. ElasticMQ doesn't support them: false locally.
SQS_FAIR_QUEUES=false

# --- worker (src/config/worker.config.ts) ---
# Queues the worker consumes, comma-separated, or * for all of them.
WORKER_QUEUES=*
# Port of the worker's health endpoint.
WORKER_HEALTH_PORT=3001

# --- whatsapp (src/config/whatsapp.config.ts) ---
# Graph API origin: mock-meta locally (tools/mock-meta), https://graph.facebook.com when deployed.
WA_GRAPH_URL=http://localhost:4010
# Graph API version for sends and webhooks.
WA_GRAPH_VERSION=v26.0
# System User access token. Local-only value below; mock-meta accepts it.
WA_ACCESS_TOKEN=local-access-token
# App secrets that sign webhooks, comma-separated (current first; the old one too while rotating).
WA_APP_SECRETS=local-app-secret-not-for-any-deployment
# Token Meta sends when verifying the webhook URL.
WA_VERIFY_TOKEN=local-verify-token-0123
# WhatsApp Business Account, phone number and business portfolio IDs (mock-meta's defaults).
WA_WABA_ID=100000000000001
WA_PHONE_NUMBER_ID=100000000000002
WA_PORTFOLIO_ID=100000000000003
# Endpoint for marketing templates: messages | marketing_messages
WA_MARKETING_ENDPOINT=messages
# The number's allowed messages per second (Meta: 80 by default, up to 1000).
WA_MAX_MPS=80
# Inbound words and button payloads that opt a number out, comma-separated.
WA_OPT_OUT_KEYWORDS=STOP,UNSUBSCRIBE
WA_OPT_OUT_PAYLOADS=
# Price per message by category, for cost estimates. Update from Meta's rate card.
WA_PRICE_CURRENCY=INR
WA_PRICE_MARKETING=0.86
WA_PRICE_UTILITY=0.12
WA_PRICE_AUTHENTICATION=0.12
