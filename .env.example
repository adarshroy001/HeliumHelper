# Copy to .env for local development. Real environment variables override this file.
# Every variable is validated at startup by the schemas in src/config; a test keeps this file in sync with them.

# --- app (src/config/app.config.ts) ---
# How Node and libraries behave: development | test | production
NODE_ENV=development
# Which deployment this is: local | staging | production
APP_ENV=local
# Port the API listens on.
PORT=3000
# Minimum log level: silent | fatal | error | warn | info | debug | trace (production: info or quieter, never silent)
LOG_LEVEL=info
# Service name shown in logs and metrics.
APP_NAME=helium-backend
# Browser origins allowed to call the API, comma-separated (https://admin.example.com). Empty: none.
CORS_ORIGINS=

# --- auth (src/config/auth.config.ts) ---
# Callers allowed to call the API, as JSON {"<iss>":"<secret of 32+ characters>"}. Local-only value below;
# `pnpm dev:token` signs a dev token with it.
AUTH_CALLER_SECRETS={"helium-admin":"local-dev-secret-not-for-any-deployment"}
