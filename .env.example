# Copy to .env for local development. Real environment variables override this file.
# Every variable is validated at startup by the schemas in src/config; a test keeps this file in sync with them.

# --- app (src/config/app.config.ts) ---
# How Node and libraries behave: development | test | production
NODE_ENV=development
# Which deployment this is: local | staging | production
APP_ENV=local
# Port the API listens on.
PORT=3000
# Minimum log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Service name shown in logs and metrics.
APP_NAME=helium-backend
